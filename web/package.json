{
  "name": "falconos-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node local-web.mjs dev",
    "build:site": "vite build",
    "dev:bot": "vite --config vite.bot.config.js --host 127.0.0.1 --port 5194 --strictPort",
    "dev:agents": "vite --config vite.agents.config.js",
    "build:bot": "vite build --config vite.bot.config.js",
    "dev:mvp": "vite --config vite.mvp.config.js",
    "build:mvp": "vite build --config vite.mvp.config.js",
    "build:agents": "vite build --config vite.agents.config.js",
    "preview:mvp": "vite preview --config vite.mvp.config.js",
    "preview:agents": "vite preview --config vite.agents.config.js",
    "preview:local": "node local-web.mjs preview",
    "snapshot": "node snapshot.mjs",
    "build": "npm run build:site",
    "build:treasury": "vite build --config vite.treasury.config.js",
    "build:mesh": "vite build --config vite.mesh.config.js",
    "pretest": "npm run build:mvp && npm run build:agents",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/treasury-browser.mjs && node test/dashboard-browser.mjs",
    "test:dashboard": "node --test test/dashboard.test.mjs",
    "test:dashboard:browser": "node test/dashboard-browser.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "@wallet-standard/app": "1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}

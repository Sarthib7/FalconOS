{
  "name": "falconos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "demo": "node src/cli.ts demo",
    "scan": "node src/cli.ts scan",
    "watch": "node src/cli.ts watch",
    "dash": "cargo run --manifest-path engine/Cargo.toml --release --quiet --",
    "serve": "cargo run --manifest-path engine/Cargo.toml --release -- serve",
    "verify": "node scripts/verify.mjs",
    "verify:repository": "node scripts/verify.mjs repository",
    "verify:advisory": "node scripts/verify.mjs advisory",
    "verify:web": "node scripts/verify.mjs web",
    "verify:mesh": "node scripts/verify.mjs mesh",
    "verify:engine": "node scripts/verify.mjs engine",
    "verify:release:web": "node web/scripts/verify-release.mjs",
    "verify:release:mesh": "node mesh/check-release.mjs",
    "verify:swap": "node web/scripts/verify-swap-build.mjs",
    "test": "node --test test/*.test.ts stablecoins/test/*.test.ts perps/test/*.test.ts stocks/test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}

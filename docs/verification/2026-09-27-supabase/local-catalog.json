  "constraints": [
    {
      "relname": "analyses",
      "conname": "analyses_analysis_check",
      "contype": "c",
      "definition": "CHECK ((jsonb_typeof(analysis) = 'object'::text))",
      "convalidated": true
    },
    {
      "relname": "analyses",
      "conname": "analyses_graph_check",
      "contype": "c",
      "definition": "CHECK ((jsonb_typeof(graph) = 'object'::text))",
      "convalidated": true
    },
    {
      "relname": "analyses",
      "conname": "analyses_max_hops_check",
      "contype": "c",
      "definition": "CHECK (((max_hops >= 1) AND (max_hops <= 3)))",
      "convalidated": true
    },
    {
      "relname": "analyses",
      "conname": "analyses_owner_id_check",
      "contype": "c",
      "definition": "CHECK ((owner_id ~ '^[a-z0-9_-]{1,64}$'::text))",
      "convalidated": true
    },
    {
      "relname": "analyses",
      "conname": "analyses_owner_id_request_id_key",
      "contype": "u",
      "definition": "UNIQUE (owner_id, request_id)",
      "convalidated": true
    },
    {
      "relname": "analyses",
      "conname": "analyses_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (owner_id, id)",
      "convalidated": true
    },
    {
      "relname": "lending_events",
      "conname": "lending_events_data_check",
      "contype": "c",
      "definition": "CHECK (((jsonb_typeof(data) = 'object'::text) AND (octet_length((data)::text) <= 1048576)))",
      "convalidated": true
    },
    {
      "relname": "lending_events",
      "conname": "lending_events_kind_check",
      "contype": "c",
      "definition": "CHECK (((length(kind) <= 16) AND (kind = ANY (ARRAY['SUBMITTED'::text, 'RECEIPT'::text]))))",
      "convalidated": true
    },
    {
      "relname": "lending_events",
      "conname": "lending_events_owner_id_check",
      "contype": "c",
      "definition": "CHECK ((owner_id ~ '^[a-z0-9_-]{1,64}$'::text))",
      "convalidated": true
    },
    {
      "relname": "lending_events",
      "conname": "lending_events_owner_id_intent_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (owner_id, intent_id) REFERENCES falcon_mesh.lending_intents(owner_id, id)",
      "convalidated": true
    },
    {
      "relname": "lending_events",
      "conname": "lending_events_owner_id_request_id_key",
      "contype": "u",
      "definition": "UNIQUE (owner_id, request_id)",
      "convalidated": true
    },
    {
      "relname": "lending_events",
      "conname": "lending_events_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (owner_id, id)",
      "convalidated": true
    },
    {
      "relname": "lending_intents",
      "conname": "lending_intents_intent_check",
      "contype": "c",
      "definition": "CHECK (((jsonb_typeof(intent) = 'object'::text) AND (octet_length((intent)::text) <= 1048576)))",
      "convalidated": true
    },
    {
      "relname": "lending_intents",
      "conname": "lending_intents_owner_id_analysis_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (owner_id, analysis_id) REFERENCES falcon_mesh.analyses(owner_id, id)",
      "convalidated": true
    },
    {
      "relname": "lending_intents",
      "conname": "lending_intents_owner_id_check",
      "contype": "c",
      "definition": "CHECK ((owner_id ~ '^[a-z0-9_-]{1,64}$'::text))",
      "convalidated": true
    },
    {
      "relname": "lending_intents",
      "conname": "lending_intents_owner_id_request_id_key",
      "contype": "u",
      "definition": "UNIQUE (owner_id, request_id)",
      "convalidated": true
    },
    {
      "relname": "lending_intents",
      "conname": "lending_intents_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (owner_id, id)",
      "convalidated": true
    },
    {
      "relname": "lending_intents",
      "conname": "lending_intents_request_check",
      "contype": "c",
      "definition": "CHECK (((jsonb_typeof(request) = 'object'::text) AND (octet_length((request)::text) <= 4096)))",
      "convalidated": true
    },
    {
      "relname": "source_heads",
      "conname": "source_heads_owner_id_source_key_revision_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (owner_id, source_key, revision_id) REFERENCES falcon_mesh.source_revisions(owner_id, source_key, revision_id)",
      "convalidated": true
    },
    {
      "relname": "source_heads",
      "conname": "source_heads_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (owner_id, source_key)",
      "convalidated": true
    },
    {
      "relname": "source_revisions",
      "conname": "source_revisions_check",
      "contype": "c",
      "definition": "CHECK ((captured_at >= observed_at))",
      "convalidated": true
    },
    {
      "relname": "source_revisions",
      "conname": "source_revisions_content_check",
      "contype": "c",
      "definition": "CHECK ((octet_length(content) <= 131072))",
      "convalidated": true
    },
    {
      "relname": "source_revisions",
      "conname": "source_revisions_owner_id_check",
      "contype": "c",
      "definition": "CHECK ((owner_id ~ '^[a-z0-9_-]{1,64}$'::text))",
      "convalidated": true
    },
    {
      "relname": "source_revisions",
      "conname": "source_revisions_owner_id_source_key_revision_id_key",
      "contype": "u",
      "definition": "UNIQUE (owner_id, source_key, revision_id)",
      "convalidated": true
    },
    {
      "relname": "source_revisions",
      "conname": "source_revisions_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (owner_id, revision_id)",
      "convalidated": true
    },
    {
      "relname": "source_revisions",
      "conname": "source_revisions_sha256_check",
      "contype": "c",
      "definition": "CHECK ((sha256 ~ '^[a-f0-9]{64}$'::text))",
      "convalidated": true
    }
  ],

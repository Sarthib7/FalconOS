    {
      "tablename": "source_revisions",
      "indexname": "source_revisions_owner_id_source_key_revision_id_key",
      "indexdef": "CREATE UNIQUE INDEX source_revisions_owner_id_source_key_revision_id_key ON falcon_mesh.source_revisions USING btree (owner_id, source_key, revision_id)"
    },
    {
      "tablename": "source_revisions",
      "indexname": "source_revisions_pkey",

# Copy this template to mesh/.env.cfo.local. Never put keys in chat or source.
# The repository and container ignore .env.cfo.local.
# Use a reviewed, initialized local database. This file does not create a schema.
# DATABASE_URL=postgresql://localhost/your_disposable_database

# Keep provider access disabled until you approve its account, terms and API usage.
FALCON_CFO_PROVIDER_ENABLED=0
# FALCON_CFO_PARTNER_API_KEY=your_own_partner_key
# FALCON_CFO_NEARBLOCKS_API_KEY=your_own_nearblocks_key

# Wallet sign-in never grants model calls or funds movement.
FALCON_CFO_REVIEW_OWNERS=[]
FALCON_CFO_EXECUTION_GRANTS=[]
FALCON_CFO_EXECUTION_TRIALS=[]

# Use the verified pinned Bun 1.3.14 binary for the native Council worker.
# FALCON_MESH_COUNCIL_BUN=/absolute/path/to/isolated/bun

# Local startup from the repository root, after the database is initialized:
# node --env-file=mesh/.env.cfo.local mesh/local.mjs
# This does not authorize a provider request, model call or funded trial.
